{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(netlify deploy --prod *)",
      "Bash(netlify deploy * --prod *)",
      "Bash(netlify deploy * --prod)",
      "Bash(netlify deploy -p)",
      "Bash(netlify deploy -p *)",
      "Bash(netlify deploy * -p *)",
      "Bash(netlify deploy * -p)",
      "Bash(netlify deploy --prod-if-unlocked *)",
      "Bash(netlify deploy * --prod-if-unlocked *)",
      "Bash(netlify deploy * --prod-if-unlocked)",
      "Bash(netlify api restoreSiteDeploy *)",
      "Bash(npx *netlify*)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git * push *)",
      "Bash(git * push)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-positions.mjs"
          }
        ]
      }
    ]
  }
}
